(ns demo.amps
  "Spin-1 AMPS comparison using light-matters' maximal-projection convention.
   Physics stays upstream; these closed forms provide a dependency-free example."
  (:require [fawltypoly.geometry :as geo]
            [fawltypoly.amps :as amps]
            [fawltypoly.expression :as expression]
            [fawltypoly.scene :as scene])
  (:import math))

(def stretched-expression '(expt (cos (/ theta 2)) 4))
(def mixed-expression '(/ 1 3))
(def aligned-expression '(* 1/2 (expt (sin theta) 2)))

(def probability
  "For rho=|1,1><1,1|, P(m_n=1) = cos(theta/2)^4, independent of phi.
   Matches lightmatters.api.v1.amps/surface and its stretched-state tests.
   Its solid-angle integral is 4*pi/3; P is not a density normalized to integral 1."
  (expression/compile stretched-expression))

(def mixed-probability
  "For the unpolarized rho=I/3, every direction has P(m_n=1)=1/3."
  (expression/compile mixed-expression))

(def aligned-probability
  "For rho=|1,0><1,0|, P(m_n=1)=sin(theta)^2/2."
  (expression/compile aligned-expression))

(defn scene-spec
  "Compare unpolarized, stretched, and aligned spin-1 states at the same scale.
   Tilt rotates the geometry about Blender's Y axis; locations stay fixed."
  ([] (scene-spec {}))
  ([{:keys [radius-scale theta-segments phi-segments tilt colormap radius-range]
     :or {radius-scale 2 theta-segments 32 phi-segments 64 tilt 0 colormap :viridis}}]
   (when-not (and (geo/finite? radius-scale) (pos? radius-scale))
     (throw (ex-info "radius-scale must be finite and positive" {})))
   {:collection "AMPS"
    :materials {:radius {:radius-color {:colormap colormap :range (or radius-range [0 radius-scale])}
                         :roughness 0.55}}
    :objects
    (mapv (fn [[id form x]]
            {:id id :name (name id)
             :mesh (amps/expression->mesh form {:radius-scale radius-scale
                                                :theta-segments theta-segments :phi-segments phi-segments})
             :location [x 0 0] :rotation [0 tilt 0] :material :radius :smooth? true})
          [[:unpolarized mixed-expression -3.2]
           [:polarized stretched-expression 0]
           [:aligned aligned-expression 3.2]])}))

(defn show!
  ([] (show! {}))
  ([options] (scene/ensure-scene! (scene-spec options))))

(comment
  (show!)
  (show! {:radius-scale 3 :tilt (/ math/pi 4) :theta-segments 48}))
