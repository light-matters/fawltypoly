(ns fawltypoly.camera
  (:require [fawltypoly.scene :as scene]
            [fawltypoly.object :as obj]))

(defn set-camera
  "Positions the camera at a particular rotation angle."
  [camera location rotation]
  (let [camera (obj/require-object camera)]
    (when-not (= "CAMERA" (.-type camera))
      (throw (ex-info "Expected a camera object" {})))
    (obj/location! camera location)
    (obj/rotation! camera rotation)
    (set! (.-camera (scene/scene)) camera)
    camera))
