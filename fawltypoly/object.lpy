(ns fawltypoly.object
  "Object access and composable mutations. Angles are in radians."
  (:require [fawltypoly.material :as mat])
  (:import bpy))

(defn objects [] (.-objects bpy/data))

(defn object
  "Resolve an object reference or name; return nil for a missing name."
  ([] (.-active_object bpy/context))
  ([ref] (if (string? ref) (.get (objects) ref) ref)))

(defn require-object [ref]
  (let [obj (object ref)]
    (when-not (instance? bpy.types/Object obj)
      (throw (ex-info "Object not found" {:object ref})))
    obj))

(defn location! [ref xyz]
  (let [obj (require-object ref)] (set! (.-location obj) xyz) obj))

(defn rotation! [ref xyz]
  (let [obj (require-object ref)] (set! (.-rotation_euler obj) xyz) obj))

(defn scale! [ref xyz]
  (let [obj (require-object ref)] (set! (.-scale obj) xyz) obj))

(defn name! [ref label]
  (let [obj (require-object ref)] (set! (.-name obj) label) obj))

(defn name-active! [label] (name! (object) label))

(defn name-mesh!
  ([label] (name-mesh! label (object)))
  ([label ref]
   (let [obj (require-object ref)]
     (set! (.-name (.-data obj)) (str label "_mesh"))
     obj)))

(defn add!
  "Legacy primitive creation. New scene workflows use mesh/create! instead."
  [& {:keys [type name name--material location rotation scale]
      :or {type :plane name "light" location [0 0 0]
           rotation [0 0 0] scale [1 1 1]}}]
  (case type
    :plane (.primitive_plane_add bpy.ops/mesh ** :location location :rotation rotation :scale scale)
    :sphere (.primitive_uv_sphere_add bpy.ops/mesh ** :location location :rotation rotation :scale scale)
    :cube (.primitive_cube_add bpy.ops/mesh ** :location location :rotation rotation :scale scale)
    (throw (ex-info "Unsupported primitive" {:type type})))
  ;; Blender may suffix a colliding name, so retain the actual new object.
  (let [obj (object)]
    (name! obj name)
    (name-mesh! (.-name obj) obj)
    (when name--material (mat/assign! obj name--material))
    obj))

(defn select
  "Select objects. Selection and active object are distinct Blender concepts."
  ([] (doseq [obj (.-objects (.-view_layer bpy/context))] (.select_set obj true)))
  ([ref] (let [obj (require-object ref)] (.select_set obj true) obj)))

(defn active! [ref]
  (let [obj (select ref)]
    (set! (.-active (.-objects (.-view_layer bpy/context))) obj)
    obj))

(defn select-type [kind]
  (let [type-name (case kind :mesh "MESH" :camera "CAMERA" :light "LIGHT"
                   (throw (ex-info "Unsupported selection type" {:type kind})))]
    (doseq [obj (.-objects (.-view_layer bpy/context))]
      (.select_set obj (= type-name (.-type obj))))))

(defn deselect
  ([] (doseq [obj (.-objects (.-view_layer bpy/context))] (.select_set obj false)))
  ([ref] (let [obj (require-object ref)] (.select_set obj false) obj)))

(defn delete!
  "Unlink an object everywhere. Shared mesh data is kept; unused mesh data is freed."
  [ref]
  (when-let [obj (object ref)]
    (let [mesh (when (= "MESH" (.-type obj)) (.-data obj))
          owned-materials (when mesh (vec (filter #(and % (.get % "fawltypoly.opacity-copy" false))
                                                 (.-materials mesh))))]
      (.remove bpy.data/objects obj ** :do_unlink true)
      (when (and mesh (zero? (.-users mesh))) (.remove bpy.data/meshes mesh))
      (doseq [material owned-materials :when (zero? (.-users material))]
        (.remove bpy.data/materials material))))
  nil)

;; Compatibility with the original API.
(def move location!)
(def rotate rotation!)
(def delete delete!)

(defn apply_transforms
  "Legacy context-dependent operator: applies transforms to selected objects."
  []
  (.transform_apply bpy.ops/object ** :rotation true :location true :scale true))
