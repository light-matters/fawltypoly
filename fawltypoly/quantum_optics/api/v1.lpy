(ns fawltypoly.quantum-optics.api.v1
  "Version 1 of the atomic/quantum-optics illustration API. No dynamics solver."
  (:require [fawltypoly.quantum-optics.objects :as objects]
            [fawltypoly.quantum-optics.material :as material]
            [fawltypoly.amps :as amps]))

(def api-version 1)
(def atom-cloud objects/atom-cloud)
(def cooling-beams objects/cooling-beams)
(def cooling-volume objects/cooling-volume)
(def circular-polarization objects/circular-polarization)
(def circular-polarization-glyph objects/circular-polarization-glyph)
(def gaussian-cooling-material! material/gaussian-cooling-material!)
(def anti-helmholtz-coils objects/anti-helmholtz-coils)
(def quadrupole-guides objects/quadrupole-guides)
(def expression->mesh amps/expression->mesh)
(def grid->mesh amps/grid->mesh)
(def read-amps-json amps/read-json)
