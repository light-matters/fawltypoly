(ns fawltypoly.interop
  "For dealing with special types and circumstances introduced by the Blender system."
  (:refer-basilisp :exclude [get get-in])
  (:require [clojure.core :as c])
  (:import bpy))

(defn debug
  "Currently necessary because stdout is"
  ;; TODO: Document `content`
  [content]
  (let [fname "log.txt"
        f (python/eval (str "open('" fname "', 'a')"))]
    (try
      (.write f (str content "\n\n"))
      (finally (.close f)))))

(defn ->hash
  "Converts a bpy_collection-like thing to a hash map."
  [bc]
  (into {} (.items bc)))

(defn get
  "Retrieve the value associated with the given key from a collection.
   Supports bpy_prop_collection, dictionaries, and other types."
  [m k & [default]]
  (let [bpy-prop-collection-type (python/getattr (python/getattr bpy "types") "bpy_prop_collection")]
    (cond
      (instance? bpy-prop-collection-type m)
      (if (integer? k)
        (try (aget m k) (catch python/IndexError _ default))
        (let [result (.get m k)] (if (nil? result) default result)))

      ;; mathutils vectors and other native sequences are not Basilisp collections.
      (and (integer? k) (not (map? m)) (python/hasattr m "__getitem__"))
      (try (aget m k)
           (catch python/IndexError _ default)
           (catch python/KeyError _ default))

      :else
      (try
        (c/get m k default)
        (catch Exception e
          (throw (python/TypeError (str "Unsupported type for get: " (type m)))))))))

(defn get-in
  "Traverse maps, sequences, Blender collections, and attributes (string keys).
   Stop at the first missing key. Existing nil values remain nil at the leaf."
  [m ks & [default]]
  (let [missing (python/object)]
    (loop [value m keys (seq ks)]
      (if-not keys
        value
        (let [k (first keys)
              next-value (if (and (string? k) (python/hasattr value k))
                           (python/getattr value k)
                           (get value k missing))]
          (if (identical? missing next-value)
            default
            (recur next-value (next keys))))))))

(comment
  (get {"a" 5} "a")
  (get {:a 5} :a)
  (println (get-in {:a {:b 5}} [:a :b])))
